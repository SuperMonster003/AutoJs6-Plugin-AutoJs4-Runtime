<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoJs4Runtime" parent="Theme.AppCompat.DayNight.DarkActionBar" />
    <!-- Explicit parents keep AppCompat from replacing the host configuration with the system one. -->
    <style name="Theme.AutoJs4Runtime.Light" parent="Theme.AppCompat.Light.DarkActionBar" />
    <style name="Theme.AutoJs4Runtime.Dark" parent="Theme.AppCompat" />
    <!-- The release history page (Compose): no action bar, it draws its own top bar. -->
    <style name="Theme.AutoJs4Runtime.Page" parent="Theme.AppCompat.DayNight.NoActionBar" />
    <style name="Theme.AutoJs4Runtime.Page.Light" parent="Theme.AppCompat.Light.NoActionBar" />
    <style name="Theme.AutoJs4Runtime.Page.Dark" parent="Theme.AppCompat.NoActionBar" />
</resources>
